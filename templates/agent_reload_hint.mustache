{{!
    @template block_ai_chat/agent_reload_hint

    Hint shown after the tool-agent successfully mutated course/module data, offering a
    one-click reload so the surrounding Moodle UI reflects the change.

    Classes required for JS:
    * data-action="agent-reload"

    Classes required for styling:
    * block_ai_chat-agent-reload

    Context variables required for this template: none.

    Example context (json):
    {}
}}
<div class="block_ai_chat-agent-reload alert alert-info d-flex flex-wrap align-items-center gap-2 mb-2">
    <span class="flex-grow-1">{{#str}}agenttoolagent_reloadhint, block_ai_chat{{/str}}</span>
    <button type="button" class="btn btn-primary btn-sm" data-action="agent-reload">
        {{#str}}agenttoolagent_reloadnow, block_ai_chat{{/str}}
    </button>
</div>
