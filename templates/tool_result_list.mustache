{{!
    @template block_ai_chat/tool_result_list

    Recently executed tool results for the MBS-10761 tool-agent flow with
    an Undo button for reversible calls within the undo window.

    Classes required for JS:
    * data-action="agent-undo"
    * data-action="agent-abort-run"
    * data-region="tool-result-list"

    Context variables required for this template:
    * runid - integer, currently active run (may be 0 when no run is active)
    * showabort - bool, whether to show the abort-run button
    * results - array of entries:
        * callid - integer
        * toolname - string
        * summary - string, localised description of what the tool did
        * undoable - bool, true when undo_payload present and window not elapsed
        * secondsLeft - integer, client-side countdown
        * undone - bool, already undone
        * ok - bool

    Example context (json):
    {
        "runid": 42,
        "showabort": true,
        "results": [
            {"callid": 101, "toolname": "course_create", "summary": "Created course \"Math 101\"",
             "undoable": true, "secondsLeft": 45, "undone": false, "ok": true}
        ]
    }
}}
<div class="block_ai_chat-toolresult-list" data-region="tool-result-list" data-runid="{{runid}}">
    {{#showabort}}
        <div class="d-flex justify-content-end mb-2">
            <button type="button" class="btn btn-sm btn-outline-danger" data-action="agent-abort-run" data-runid="{{runid}}">
                {{#str}}agentabortrun, block_ai_chat{{/str}}
            </button>
        </div>
    {{/showabort}}
    {{#results}}
        <div class="block_ai_chat-toolresult card mb-2" data-callid="{{callid}}">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="font-weight-bold">{{toolname}}</span>
                        <span class="ml-2">{{summary}}</span>
                    </div>
                    {{#undoable}}
                        {{^undone}}
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-action="agent-undo" data-callid="{{callid}}">
                                {{#str}}agentundotoolresult, block_ai_chat, {{secondsLeft}}{{/str}}
                            </button>
                        {{/undone}}
                    {{/undoable}}
                    {{#undone}}
                        <span class="badge badge-secondary">{{#str}}agentundodone, block_ai_chat{{/str}}</span>
                    {{/undone}}
                </div>
            </div>
        </div>
    {{/results}}
</div>
