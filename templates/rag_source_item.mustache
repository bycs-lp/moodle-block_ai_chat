{{!
    @template block_ai_chat/rag_source_item

    Single list item for a RAG source reference.

    Context variables:
    * sourceId int
    * title string
    * url string
    * isLinked bool
    * locatorDisplay string
}}
<li data-sourceid="{{sourceId}}">
    {{#isLinked}}
        <a href="{{url}}" target="_blank" rel="noopener noreferrer">{{title}}</a>
    {{/isLinked}}
    {{^isLinked}}
        {{title}}
    {{/isLinked}}
    {{#locatorDisplay}} {{locatorDisplay}}{{/locatorDisplay}}
</li>
